+bool CorporateLocalAddress(const SockaddrStorage& address) {
+  if (address.addr()->sa_family == AF_UNIX)
+    return true;
+  IPEndPoint endpoint;
+  if (!endpoint.FromSockAddr(address.addr(), address.addr_len))
+    return false;
+  const IPAddress ip = endpoint.address().IsIPv4MappedIPv6()
+                           ? ConvertIPv4MappedIPv6ToIPv4(endpoint.address())
+                           : endpoint.address();
+  return ip.IsLoopback();
+}
